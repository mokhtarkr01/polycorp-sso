dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword by self write by dn.exact="cn=admin,dc=polycorp,dc=com" write by anonymous auth by * none
olcAccess: {1}to * by dn.exact="cn=admin,dc=polycorp,dc=com" write by dn.exact="uid=keycloak-svc,ou=services,dc=polycorp,dc=com" read by self read by * none
